# Todas opcionais. Nenhum segredo é necessário neste projeto.
# Caminho explícito para o ZIP da base, se não estiver no workspace nem em ~/Downloads
HOUSEVALUE_ZIP=
# Pasta de artefatos usada pela API (padrão: ./artifacts)
HOUSEVALUE_ARTIFACTS_DIR=
# Origens permitidas por CORS quando o frontend é servido separadamente
HOUSEVALUE_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
# Tamanho máximo do corpo das requisições POST (bytes)
HOUSEVALUE_MAX_BODY_BYTES=16384
